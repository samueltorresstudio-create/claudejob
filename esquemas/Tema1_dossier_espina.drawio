        <mxCell id="chip2_0_4" value="&lt;font style=&quot;font-size:12px;color:#A6303F;&quot;&gt;&lt;font color=&quot;#A6303F&quot;&gt;&amp;#9733; &lt;/font&gt;5.&amp;ordf; &amp;#183; 1984-98 &amp;#183; PC e Internet civil&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=nowrap;html=1;fillColor=#FCEEEF;strokeColor=#A6303F;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Verdana,Arial,sans-serif;" vertex="1" parent="1">
