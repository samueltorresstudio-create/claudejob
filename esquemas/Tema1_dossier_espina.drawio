        </mxCell>
        <mxCell id="chip3_0_2" value="&lt;font style=&quot;font-size:12px;color:#276B66;&quot;&gt;&lt;font color=&quot;#A6303F&quot;&gt;&amp;#9733; &lt;/font&gt;Tr&amp;aacute;fico y coches aut&amp;oacute;nomos&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=nowrap;html=1;fillColor=#EAF4F2;strokeColor=#A6303F;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Verdana,Arial,sans-serif;" vertex="1" parent="1">
