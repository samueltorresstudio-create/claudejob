          <mxGeometry x="886.0" y="948.0" width="5.0" height="169.0" as="geometry" />
        </mxCell>
        <mxCell id="mk1_3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8B5A34;strokeColor=#FAF6ED;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="834.0" y="1026.5" width="12.0" height="12.0" as="geometry" />
        </mxCell>
        <mxCell id="ce1_3" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#8B5A34;strokeWidth=2;endArrow=none;startArrow=none;entryX=0;entryY=0.5;exitX=0.5;exitY=0.5;" edge="1" parent="1" source="mk1_3" target="card1_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ban2" value="&lt;div style=&quot;fontFamily=Georgia,&quot;Times New Roman&quot;,serif; font-size:20px;font-weight:700;color:#FFFFFF;&quot;&gt;2 &amp;#183; Evoluci&amp;oacute;n tecnol&amp;oacute;gica&lt;/div&gt;&lt;div style=&quot;fontFamily=Verdana,Arial,sans-serif; font-size:12.5px;color:#FFFFFF;opacity:.92;margin-top:3px;&quot;&gt;El recorrido t&amp;eacute;cnico desde la Prehistoria hasta la inform&amp;aacute;tica actual, &amp;eacute;poca a &amp;eacute;poca.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#A6303F;strokeColor=none;align=center;verticalAlign=middle;shadow=1;fontFamily=Verdana,Arial,sans-serif;" vertex="1" parent="1">
