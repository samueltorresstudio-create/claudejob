        </mxCell>
        <mxCell id="chip2_1_0" value="&lt;font style=&quot;font-size:12px;color:#A6303F;&quot;&gt;&lt;font color=&quot;#A6303F&quot;&gt;&amp;#9733; &lt;/font&gt;6.&amp;ordf; &amp;#183; 1999-hoy &amp;#183; m&amp;oacute;vil y paralelismo&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=nowrap;html=1;fillColor=#FCEEEF;strokeColor=#A6303F;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Verdana,Arial,sans-serif;" vertex="1" parent="1">
