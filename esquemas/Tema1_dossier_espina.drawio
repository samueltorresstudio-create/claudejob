        <mxCell id="ban1" value="&lt;div style=&quot;fontFamily=Georgia,&quot;Times New Roman&quot;,serif; font-size:20px;font-weight:700;color:#FFFFFF;&quot;&gt;1 &amp;#183; Hacia la sociedad actual&lt;/div&gt;&lt;div style=&quot;fontFamily=Verdana,Arial,sans-serif; font-size:12.5px;color:#FFFFFF;opacity:.92;margin-top:3px;&quot;&gt;Cuatro revoluciones econ&amp;oacute;micas y sociales encadenadas que explican d&amp;oacute;nde estamos hoy.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#8B5A34;strokeColor=none;align=center;verticalAlign=middle;shadow=1;fontFamily=Verdana,Arial,sans-serif;" vertex="1" parent="1">
