          <mxGeometry x="300.0" y="2331.5" width="1080.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="chip3_0_0" value="&lt;font style=&quot;font-size:12px;color:#276B66;&quot;&gt;&lt;font color=&quot;#A6303F&quot;&gt;&amp;#9733; &lt;/font&gt;eAdministraci&amp;oacute;n&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=nowrap;html=1;fillColor=#EAF4F2;strokeColor=#A6303F;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="423.8" y="2351.5" width="162.2" height="30.0" as="geometry" />
