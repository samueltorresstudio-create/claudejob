        <mxCell id="chiptitle2" value="&lt;font style=&quot;font-size:11.5px;color:#A6303F;font-weight:700;letter-spacing:.4px;&quot;&gt;Generaciones de los ordenadores &amp;#183; cada una reduce coste y tama&amp;ntilde;o, y gana velocidad&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="300.0" y="1249.0" width="1080.0" height="18.0" as="geometry" />
