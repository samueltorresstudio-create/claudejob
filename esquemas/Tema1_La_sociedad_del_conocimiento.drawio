        <mxCell id="c4_0_1" value="&lt;font style=&quot;font-size:13.5px;color:#1462B4&quot;&gt;&lt;b&gt;&lt;font color=&quot;#B02A25&quot;&gt;&amp;#9733; &lt;/font&gt;4.2 El certificado digital&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;Autentica y cifra las comunicaciones en redes abiertas y evita suplantaciones. En Espa&amp;ntilde;a lo emite la FNMT.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B02A25;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
