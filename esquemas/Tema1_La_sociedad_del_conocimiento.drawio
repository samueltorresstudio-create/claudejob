        <mxCell id="c2_0_0i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="614" y="574" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_1" value="&lt;font style=&quot;font-size:13.5px;color:#D8511A&quot;&gt;&lt;b&gt;2.2 La Edad Media&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;El saber se refugia en monasterios: p&amp;oacute;lvora, br&amp;uacute;jula y gafas. El cero (India) y la imprenta de Gutenberg (1440).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#D8511A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="696" y="562" width="292" height="134" as="geometry" />
        </mxCell>
