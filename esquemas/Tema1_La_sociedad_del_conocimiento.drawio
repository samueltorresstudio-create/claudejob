        <mxCell id="c5_0_0" value="&lt;font style=&quot;font-size:11px;color:#6A1B9A&quot;&gt;&lt;b&gt;5.1 Inteligencia colectiva&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Colaboraci&amp;oacute;n que resuelve problemas multidisciplinares; la Web 2.0 convierte al consumidor en creador.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="1446" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c5_0_1" value="&lt;font style=&quot;font-size:11px;color:#6A1B9A&quot;&gt;&lt;b&gt;5.2 Contenidos abiertos&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Licencias que permiten copiar, distribuir y modificar: REA, MOOC, Creative Commons y Copyleft.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
