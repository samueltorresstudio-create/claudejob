        <mxCell id="c3_1_1" value="&lt;font style=&quot;font-size:11px;color:#00796B&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;Teletrabajo&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Actividad laboral a distancia desde cualquier lugar con un ordenador conectado a la Red.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
