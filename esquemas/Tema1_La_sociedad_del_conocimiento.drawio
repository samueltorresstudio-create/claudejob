        <mxCell id="band1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFBF2;strokeColor=#E08A00;strokeWidth=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="1638" height="344" as="geometry" />
        </mxCell>
        <mxCell id="cap1" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;1. HACIA LA SOCIEDAD ACTUAL&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:10px&quot;&gt;&lt;br style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;Cuatro revoluciones encadenadas: agraria, industrial, de la informaci&amp;oacute;n y del conocimiento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E08A00;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;spacingLeft=12;spacingRight=12;spacingTop=26;" vertex="1" parent="1">
          <mxGeometry x="56" y="196" width="270" height="312" as="geometry" />
        </mxCell>
        <mxCell id="cap1ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="172" y="212" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8FA0AA;strokeWidth=3;endArrow=block;endFill=1;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="banner" target="cap1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_0" value="&lt;font style=&quot;font-size:13.5px;color:#E08A00&quot;&gt;&lt;b&gt;1.1 Sociedad agraria y artesanal&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;Del fuego a la agricultura: los excedentes crean una sociedad compleja; en la Edad Antigua nacen artesan&amp;iacute;a y comercio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E08A00;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="362" y="196" width="292" height="134" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_0i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="614" y="208" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_1" value="&lt;font style=&quot;font-size:13.5px;color:#E08A00&quot;&gt;&lt;b&gt;1.2 La sociedad industrial&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;Resurgen ciudades y burgues&amp;iacute;a; la m&amp;aacute;quina de vapor y el ferrocarril disparan la econom&amp;iacute;a.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E08A00;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="696" y="196" width="292" height="134" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_1i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="948" y="208" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_2" value="&lt;font style=&quot;font-size:13.5px;color:#E08A00&quot;&gt;&lt;b&gt;1.3 La sociedad de la informaci&amp;oacute;n&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;Crecen los servicios y las TIC: crear y difundir informaci&amp;oacute;n desde cualquier lugar. La informaci&amp;oacute;n es poder.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E08A00;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="196" width="292" height="134" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_2i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="1282" y="208" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_3" value="&lt;font style=&quot;font-size:13.5px;color:#E08A00&quot;&gt;&lt;b&gt;1.4 La sociedad del conocimiento&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;Conocimiento = informaci&amp;oacute;n ya interpretada. Genera desarrollo propio y pone a las personas en el centro.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E08A00;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
