        <mxCell id="c7_0_3" value="&lt;font style=&quot;font-size:11px;color:#2E7D32&quot;&gt;&lt;b&gt;7.4 Litograf&amp;iacute;a&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Fotolitograf&amp;iacute;a para fabricar chips cada vez menores; el haz de electrones (e-beam) supera sus l&amp;iacute;mites.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1182" y="1942" width="272" height="94" as="geometry" />
