          <mxGeometry x="948" y="574" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_2" value="&lt;font style=&quot;font-size:13.5px;color:#D8511A&quot;&gt;&lt;b&gt;2.3 La Edad Moderna&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;1492-1789: Cop&amp;eacute;rnico, Galileo y Newton. Regla de c&amp;aacute;lculo, pascalina y calculadora universal de Leibniz.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#D8511A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
