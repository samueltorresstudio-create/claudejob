        <mxCell id="cap7" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;7. NUEVOS DESARROLLOS DE LAS TIC&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Los avances que hoy empujan la inform&amp;aacute;tica y las comunicaciones.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
