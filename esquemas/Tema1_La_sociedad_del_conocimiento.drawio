        <mxCell id="c1_1_0" value="&lt;font style=&quot;font-size:13.5px;color:#E08A00&quot;&gt;&lt;b&gt;Consecuencias sociales de las TIC&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;Brecha digital, analfabetismo digital y adicci&amp;oacute;n a m&amp;oacute;viles, redes y videoconsolas.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E08A00;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
