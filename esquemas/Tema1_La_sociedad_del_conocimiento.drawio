<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17" type="device">
  <diagram id="tema1" name="Tema 1 - La sociedad del conocimiento">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="&lt;font style=&quot;font-size:28px&quot;&gt;&lt;b&gt;TEMA 1 &amp;#160;&amp;#183;&amp;#160; LA SOCIEDAD DEL CONOCIMIENTO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Esquema de contenidos &amp;#183; cap&amp;iacute;tulos, ep&amp;iacute;grafes y nota de lectura&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1B2A38;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1434" height="84" as="geometry" />
        </mxCell>
        <mxCell id="leyenda" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;&amp;#9733;&lt;/b&gt;&lt;/font&gt;&amp;#160; Contenido del guion del Tema 1 &amp;#160;&amp;#160;&amp;#9679;&amp;#160;&amp;#160; Barra de color = cap&amp;iacute;tulo &amp;#160;&amp;#160;&amp;#9679;&amp;#160;&amp;#160; Tarjeta = ep&amp;iacute;grafe + idea clave&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#F4F6F7;strokeColor=#DDE3E6;align=center;verticalAlign=middle;fontColor=#41525E;" vertex="1" parent="1">
          <mxGeometry x="40" y="116" width="1434" height="30" as="geometry" />
        </mxCell>
        <mxCell id="band1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFDF3;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="164" width="1434" height="230" as="geometry" />
        </mxCell>
        <mxCell id="cap1" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;1. HACIA LA SOCIEDAD ACTUAL&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cuatro revoluciones encadenadas: agraria, industrial, de la informaci&amp;oacute;n y del conocimiento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F9A825;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="54" y="178" width="250" height="202" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA7B0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.08;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="banner" target="cap1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_0" value="&lt;font style=&quot;font-size:11px;color:#F9A825&quot;&gt;&lt;b&gt;1.1 La sociedad agraria y artesanal&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Del fuego a la agricultura: los excedentes crean una sociedad compleja; en la Edad Antigua nacen artesan&amp;iacute;a y comercio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="178" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_1" value="&lt;font style=&quot;font-size:11px;color:#F9A825&quot;&gt;&lt;b&gt;1.2 La sociedad industrial&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Resurgen ciudades y burgues&amp;iacute;a a costa del asalariado; la m&amp;aacute;quina de vapor y el ferrocarril disparan la econom&amp;iacute;a.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="606" y="178" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_2" value="&lt;font style=&quot;font-size:11px;color:#F9A825&quot;&gt;&lt;b&gt;1.3 La sociedad de la informaci&amp;oacute;n&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Crecen los servicios y las TIC: crear y difundir informaci&amp;oacute;n desde cualquier lugar. La informaci&amp;oacute;n es poder.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="894" y="178" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_3" value="&lt;font style=&quot;font-size:11px;color:#F9A825&quot;&gt;&lt;b&gt;1.4 La sociedad del conocimiento&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Conocimiento = informaci&amp;oacute;n ya interpretada. Genera desarrollo propio y sit&amp;uacute;a a las personas en el centro.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1182" y="178" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c1_1_0" value="&lt;font style=&quot;font-size:11px;color:#F9A825&quot;&gt;&lt;b&gt;Consecuencias sociales de las TIC&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Brecha digital, analfabetismo digital y adicci&amp;oacute;n a m&amp;oacute;viles, redes y videoconsolas.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="286" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF6F0;strokeColor=#E65100;strokeWidth=1;align=left;verticalAlign=top;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="412" width="1434" height="368" as="geometry" />
        </mxCell>
        <mxCell id="cap2" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;2. EVOLUCI&amp;Oacute;N TECNOL&amp;Oacute;GICA&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;De la piedra tallada al chip: los hitos t&amp;eacute;cnicos de cada &amp;eacute;poca.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="54" y="426" width="250" height="340" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA7B0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cap1" target="cap2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_0" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;2.1 Prehistoria y Antig&amp;uuml;edad&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Fuego, lenguaje y alfabetos organizan la sociedad. El &amp;aacute;baco (3500 a. C.) es el primer instrumento de c&amp;aacute;lculo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="426" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_1" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;2.2 La Edad Media&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;El saber se refugia en monasterios: p&amp;oacute;lvora, br&amp;uacute;jula y gafas. El cero (India) y la imprenta de Gutenberg (1440).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="606" y="426" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_2" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;2.3 La Edad Moderna&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;1492-1789: Cop&amp;eacute;rnico, Galileo y Newton. Regla de c&amp;aacute;lculo, pascalina y calculadora universal de Leibniz.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="894" y="426" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_3" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;2.4 La Edad Contempor&amp;aacute;nea&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Revoluci&amp;oacute;n Industrial. Babbage idea la m&amp;aacute;quina anal&amp;iacute;tica (1822), Hollerith usa tarjetas perforadas y Zuse crea las Z1-Z4 y el Mark I.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1182" y="426" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="rt2_1" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;GENERACIONES DE LOS ORDENADORES &amp;#183; cada una reduce coste y tama&amp;ntilde;o y gana velocidad&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="318" y="534" width="1136" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_0" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;1.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1944-1953&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;V&amp;aacute;lvulas de vac&amp;iacute;o. ENIAC (1946), primer servicio de telefon&amp;iacute;a m&amp;oacute;vil (1947) y tarjetas perforadas (1953).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="564" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_1" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;2.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1955-1963&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;El transistor reduce los equipos. Nace la IA en Dartmouth (1957), Sputnik I y robots industriales (1963).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="606" y="564" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_2" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;3.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1964-1970&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Circuitos integrados. Fibra &amp;oacute;ptica (1966), ARPANET (1969) y primera memoria RAM de Intel (1970).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="894" y="564" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_3" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;4.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1971-1983&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Microprocesador y primer correo electr&amp;oacute;nico. TCP/IP (1972), Ethernet (1974), CD (1981) y nace Internet (1983).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1182" y="564" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c2_2_0" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;5.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1984-1998&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Microelectr&amp;oacute;nica y nanotecnolog&amp;iacute;a popularizan el PC. Windows (1985), WWW (1990), GSM (1992) y Google (1998).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="672" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c2_2_1" value="&lt;font style=&quot;font-size:11px;color:#E65100&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;6.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1999-actualidad&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Arquitecturas paralelas y auge m&amp;oacute;vil. Wikipedia (2001), impresoras 3D (2009); hoy IA y nanotecnolog&amp;iacute;a.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="606" y="672" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="band3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F1FAF8;strokeColor=#00796B;strokeWidth=1;align=left;verticalAlign=top;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="798" width="1434" height="368" as="geometry" />
        </mxCell>
        <mxCell id="cap3" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;3. UN MUNDO DIGITAL CONECTADO A LA RED&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Internet nace en los a&amp;ntilde;os sesenta; hoy conecta desde cualquier lugar y en cualquier momento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#00796B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="54" y="812" width="250" height="340" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA7B0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cap2" target="cap3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3_0_0" value="&lt;font style=&quot;font-size:11px;color:#00796B&quot;&gt;&lt;b&gt;3.1 Nativos digitales&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Nativos criados entre pantallas y redes frente a inmigrantes digitales, venidos de la era anal&amp;oacute;gica.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#00796B;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="812" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c3_0_1" value="&lt;font style=&quot;font-size:11px;color:#00796B&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;3.2 El Internet de las cosas&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Objetos que recogen y comparten informaci&amp;oacute;n solos (M2M). 50 000 millones conectados: seis por habitante.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="606" y="812" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c3_0_2" value="&lt;font style=&quot;font-size:11px;color:#00796B&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;Ejemplos de IoT&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Juguetes con sensores, camisetas que cambian de mensaje y zapatillas con GPS que miden el ejercicio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="894" y="812" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c3_0_3" value="&lt;font style=&quot;font-size:11px;color:#00796B&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;3.3 Ciudades inteligentes&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Tecnolog&amp;iacute;a para mejorar calidad de vida, recursos y energ&amp;iacute;a: innovaci&amp;oacute;n, sostenibilidad y gobierno digital.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
