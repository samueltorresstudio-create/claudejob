        <mxCell id="c7_1_0" value="&lt;font style=&quot;font-size:11px;color:#2E7D32&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;7.5 Nanotecnolog&amp;iacute;a&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Escala de &amp;aacute;tomos (nan&amp;oacute;metro = millon&amp;eacute;sima de mm): nanoelectr&amp;oacute;nica, nanobiotecnolog&amp;iacute;a y nanomateriales.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="2050" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c7_1_1" value="&lt;font style=&quot;font-size:11px;color:#2E7D32&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;7.6 Inform&amp;aacute;tica cu&amp;aacute;ntica&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Usa propiedades de las part&amp;iacute;culas en vez de voltajes: el qubit admite varios valores a la vez.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="606" y="2050" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c7_1_2" value="&lt;font style=&quot;font-size:11px;color:#2E7D32&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;7.7 Bioinform&amp;aacute;tica&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Biolog&amp;iacute;a e inform&amp;aacute;tica unidas: biochips, transistores org&amp;aacute;nicos que imitan neuronas y diodos OLED.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="894" y="2050" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="fuente" value="&lt;font style=&quot;font-size:10px&quot;&gt;Fuente: Tema 1 &amp;laquo;La sociedad del conocimiento. Nuevas tecnolog&amp;iacute;as&amp;raquo; (Aula Virtual) &amp;#183; Esquema propio: cada tarjeta condensa en tres l&amp;iacute;neas su p&amp;aacute;rrafo del libro. No es un resumen ni un &amp;iacute;ndice.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FAFBFB;strokeColor=#E2E7EA;align=center;verticalAlign=middle;fontColor=#6B7A85;" vertex="1" parent="1">
