        <mxCell id="c4_0_0" value="&lt;font style=&quot;font-size:13.5px;color:#1462B4&quot;&gt;&lt;b&gt;4.1 DNIe&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;Chip que acredita la identidad y firma documentos con validez jur&amp;iacute;dica. Necesita lector y PIN.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#1462B4;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=114;spacingTop=6;shadow=1;" vertex="1" parent="1">
