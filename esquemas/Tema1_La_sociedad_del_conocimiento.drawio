        <mxCell id="cap2" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;2. EVOLUCI&amp;Oacute;N TECNOL&amp;Oacute;GICA&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:10px&quot;&gt;&lt;br style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;De la piedra tallada al chip: los hitos t&amp;eacute;cnicos de cada &amp;eacute;poca.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D8511A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;spacingLeft=12;spacingRight=12;spacingTop=26;" vertex="1" parent="1">
