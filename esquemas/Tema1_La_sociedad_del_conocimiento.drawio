          <mxGeometry x="1282" y="574" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_3" value="&lt;font style=&quot;font-size:13.5px;color:#D8511A&quot;&gt;&lt;b&gt;&lt;font color=&quot;#B02A25&quot;&gt;&amp;#9733; &lt;/font&gt;2.4 La Edad Contempor&amp;aacute;nea&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;Revoluci&amp;oacute;n Industrial. Babbage idea la m&amp;aacute;quina anal&amp;iacute;tica (1822), Hollerith usa tarjetas perforadas y Zuse crea el Mark I.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B02A25;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
