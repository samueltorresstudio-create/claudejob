        </mxCell>
        <mxCell id="c2_1_2" value="&lt;font style=&quot;font-size:13.5px;color:#D8511A&quot;&gt;&lt;b&gt;&lt;font color=&quot;#B02A25&quot;&gt;&amp;#9733; &lt;/font&gt;3.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1964-1970&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;Circuitos integrados. Fibra &amp;oacute;ptica (1966), ARPANET (1969) y primera memoria RAM de Intel (1970).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B02A25;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
