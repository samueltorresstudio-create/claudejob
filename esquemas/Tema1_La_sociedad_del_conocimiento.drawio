        <mxCell id="banner" value="&lt;font style=&quot;font-size:32px&quot;&gt;&lt;b&gt;TEMA 1 &amp;#160;&amp;#183;&amp;#160; LA SOCIEDAD DEL CONOCIMIENTO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Esquema de contenidos &amp;#183; cap&amp;iacute;tulos, ep&amp;iacute;grafes e idea clave&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#16242E;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1638" height="92" as="geometry" />
        </mxCell>
        <mxCell id="leyenda" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;font color=&quot;#B02A25&quot;&gt;&lt;b&gt;&amp;#9733;&lt;/b&gt;&lt;/font&gt;&amp;#160; Contenido del guion del Tema 1&amp;#160;&amp;#160;&amp;#9679;&amp;#160;&amp;#160; Barra de color = cap&amp;iacute;tulo &amp;#160;&amp;#160;&amp;#9679;&amp;#160;&amp;#160; Tarjeta = ep&amp;iacute;grafe &amp;#160;&amp;#160;&amp;#9679;&amp;#160;&amp;#160; Las flechas marcan el orden de lectura&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#F1F4F5;strokeColor=#DCE3E6;align=center;verticalAlign=middle;fontColor=#3E4F5A;" vertex="1" parent="1">
