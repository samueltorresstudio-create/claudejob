        <mxCell id="c6_0_0" value="&lt;font style=&quot;font-size:11px;color:#00838F&quot;&gt;&lt;b&gt;6.1 El tel&amp;eacute;fono inteligente&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;M&amp;oacute;vil con prestaciones de ordenador: pantalla t&amp;aacute;ctil, GPS, Wi-Fi, c&amp;aacute;mara y multitarea.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="1694" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_1" value="&lt;font style=&quot;font-size:11px;color:#00838F&quot;&gt;&lt;b&gt;6.2 Tecnolog&amp;iacute;as ubicuas&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;&amp;laquo;En todas partes&amp;raquo;: el ordenador se integra en las tareas y deja de percibirse como m&amp;aacute;quina.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="606" y="1694" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_2" value="&lt;font style=&quot;font-size:11px;color:#00838F&quot;&gt;&lt;b&gt;6.3 Navegar con dispositivos m&amp;oacute;viles&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Safari, Chrome, Firefox u Opera; las webs tienen versi&amp;oacute;n m&amp;oacute;vil y la interacci&amp;oacute;n es t&amp;aacute;ctil.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="894" y="1694" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_3" value="&lt;font style=&quot;font-size:11px;color:#00838F&quot;&gt;&lt;b&gt;6.4 Correo electr&amp;oacute;nico&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Se lee en tiempo real desde el m&amp;oacute;vil: se sincroniza y avisa solo (Outlook, Gmail).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1182" y="1694" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c6_1_0" value="&lt;font style=&quot;font-size:11px;color:#00838F&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;6.5 Geolocalizaci&amp;oacute;n&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;GPS y cartograf&amp;iacute;a sit&amp;uacute;an el objeto en coordenadas: planificar rutas y compartir posici&amp;oacute;n en tiempo real.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="1802" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c6_1_1" value="&lt;font style=&quot;font-size:11px;color:#00838F&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;6.6 Realidad aumentada&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;La c&amp;aacute;mara superpone informaci&amp;oacute;n al entorno: paradas, restaurantes o monumentos. Ejemplo: Layar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
