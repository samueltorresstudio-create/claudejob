        <mxCell id="c4_0_0" value="&lt;font style=&quot;font-size:11px;color:#1565C0&quot;&gt;&lt;b&gt;4.1 DNIe&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Chip que acredita la identidad y firma documentos con validez jur&amp;iacute;dica. Necesita lector y PIN.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="1198" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c4_0_1" value="&lt;font style=&quot;font-size:11px;color:#1565C0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;4.2 El certificado digital&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Autentica y cifra las comunicaciones en redes abiertas y evita suplantaciones. En Espa&amp;ntilde;a lo emite la FNMT.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="606" y="1198" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c4_0_2" value="&lt;font style=&quot;font-size:11px;color:#1565C0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;C&amp;oacute;mo obtenerlo&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Acudir a una oficina de registro, instalar el software y guardar la clave privada que identifica al usuario.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="894" y="1198" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c4_0_3" value="&lt;font style=&quot;font-size:11px;color:#1565C0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;4.3 Contrase&amp;ntilde;as&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Larga, sin datos personales, alfanum&amp;eacute;rica con may&amp;uacute;sculas y s&amp;iacute;mbolos, y cambiada con regularidad.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1182" y="1198" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c4_1_0" value="&lt;font style=&quot;font-size:11px;color:#1565C0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;Truco para crearlas&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Partir de una frase f&amp;aacute;cil: &amp;laquo;Mi perro Canela es un Setter Irland&amp;eacute;s&amp;raquo; se convierte en MpCe1setterIr.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
