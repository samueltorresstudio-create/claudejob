        <mxCell id="cap5" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;5. CONOCIMIENTO COLECTIVO&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;El usuario deja de ser receptor pasivo y pasa a crear conocimiento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#6A1B9A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
