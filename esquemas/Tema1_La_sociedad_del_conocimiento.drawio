        <mxCell id="cap4" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;4. IDENTIDAD DIGITAL&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tambi&amp;eacute;n en la Red hay que acreditar qui&amp;eacute;n es cada uno.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
