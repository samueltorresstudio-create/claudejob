        <mxCell id="c5_0_3" value="&lt;font style=&quot;font-size:11px;color:#6A1B9A&quot;&gt;&lt;b&gt;Ejemplos de creaci&amp;oacute;n colectiva&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;YouTube, Wikipedia y Google Maps o Earth: contenido creado, compartido y comentado por los usuarios.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1182" y="1446" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c5_1_0" value="&lt;font style=&quot;font-size:11px;color:#6A1B9A&quot;&gt;&lt;b&gt;Internet como fuente&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Millones de sitios accesibles por buscadores: enciclopedias, bibliotecas virtuales y portales educativos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="1554" width="272" height="94" as="geometry" />
        </mxCell>
