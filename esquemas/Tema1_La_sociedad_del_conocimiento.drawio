<mxfile host="app.diagrams.net" modified="2026-09-22T00:00:00.000Z" agent="Claude Code" version="24.7.17" type="device">
  <diagram id="tema1-sociedad-conocimiento" name="Tema 1 - La sociedad del conocimiento">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="&lt;font style=&quot;font-size:26px&quot;&gt;&lt;b&gt;TEMA 1 &amp;#183; LA SOCIEDAD DEL CONOCIMIENTO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Esquema de contenidos con notas &amp;#183; cap&amp;iacute;tulos, ep&amp;iacute;grafes e ideas clave&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#263238;strokeColor=#263238;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2090" height="80" as="geometry" />
        </mxCell>
        <mxCell id="leyenda" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;LEYENDA&lt;/b&gt; &amp;#160;&amp;#160; &lt;font color=&quot;#C62828&quot;&gt;&amp;#9733;&lt;/font&gt; Contenido incluido en el guion del Tema 1 &amp;#160;&amp;#183;&amp;#160; Recuadro de color = cap&amp;iacute;tulo &amp;#160;&amp;#183;&amp;#160; Tarjeta = ep&amp;iacute;grafe con su nota de lectura (idea resumida en 3 l&amp;iacute;neas)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ECEFF1;strokeColor=#B0BEC5;align=center;verticalAlign=middle;fontColor=#37474F;" vertex="1" parent="1">
          <mxGeometry x="40" y="114" width="2090" height="34" as="geometry" />
        </mxCell>
        <mxCell id="band1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#F9A825;strokeWidth=1;dashed=1;dashPattern=6 6;align=left;verticalAlign=top;fontSize=10;fontColor=#F9A825;" vertex="1" parent="1">
          <mxGeometry x="40" y="168" width="2090" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cap1" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;1. HACIA LA SOCIEDAD ACTUAL&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cuatro revoluciones encadenadas: agraria, industrial, de la informaci&amp;oacute;n y del conocimiento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F9A825;strokeColor=#F9A825;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="184" width="200" height="168" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78909C;strokeWidth=2;endArrow=block;endFill=1;exitX=0.05;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="banner" target="cap1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_0" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1.1 La sociedad agraria y artesanal&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Del fuego y la piedra tallada al sedentarismo. Agricultura y ganader&amp;iacute;a generan excedentes y sociedad compleja. En la Edad Antigua nacen la artesan&amp;iacute;a y el comercio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="184" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_1" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1.2 La sociedad industrial&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Al final de la Edad Media resurgen ciudades y burgues&amp;iacute;a, que se enriquece a costa del asalariado. M&amp;aacute;quina de vapor, transportes y ferrocarril aceleran la econom&amp;iacute;a.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="547" y="184" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_2" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1.3 La sociedad de la informaci&amp;oacute;n&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Crece el sector servicios y se desarrollan las TIC. Cualquiera puede crear, distribuir y editar informaci&amp;oacute;n desde cualquier lugar: la informaci&amp;oacute;n es poder.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="809" y="184" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_3" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1.4 La sociedad del conocimiento&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Informaci&amp;oacute;n no es conocimiento: este es la informaci&amp;oacute;n ya interpretada y relacionada. Tiene dimensi&amp;oacute;n social, cultural y econ&amp;oacute;mica y pone a las personas en el centro.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1071" y="184" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c1_0_4" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Consecuencias sociales de las TIC&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Brecha digital entre quienes acceden a las TIC y quienes no; analfabetismo digital de quien no sabe usarlas; y adicci&amp;oacute;n al m&amp;oacute;vil, las redes o las videoconsolas.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1333" y="184" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#EF6C00;strokeWidth=1;dashed=1;dashPattern=6 6;align=left;verticalAlign=top;fontSize=10;fontColor=#EF6C00;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="2090" height="400" as="geometry" />
        </mxCell>
        <mxCell id="cap2" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;2. EVOLUCI&amp;Oacute;N TECNOL&amp;Oacute;GICA&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Recorrido por los avances t&amp;eacute;cnicos desde la Prehistoria hasta la inform&amp;aacute;tica actual.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#EF6C00;strokeColor=#EF6C00;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="406" width="200" height="368" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78909C;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cap1" target="cap2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_0" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2.1 Prehistoria y Antig&amp;uuml;edad&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;El fuego, el lenguaje oral y los alfabetos organizan las primeras sociedades. El &amp;aacute;baco (Babilonia, 3500 a. C.) es el primer instrumento de c&amp;aacute;lculo; Grecia sustituye el mito por la raz&amp;oacute;n.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="406" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_1" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2.2 La Edad Media&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;El conocimiento queda relegado a monasterios y universidades. Llegan p&amp;oacute;lvora, br&amp;uacute;jula, gafas y molinos de viento; y destacan el cero (India) y la imprenta de Gutenberg (1440).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="547" y="406" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_2" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2.3 La Edad Moderna&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;De 1492 a 1789: Cop&amp;eacute;rnico, Da Vinci, Galileo y Newton. Nacen la regla de c&amp;aacute;lculo, la pascalina y la calculadora universal de Leibniz, y se impone la m&amp;aacute;quina de vapor.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="809" y="406" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c2_0_3" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 2.4 La Edad Contempor&amp;aacute;nea&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;La Revoluci&amp;oacute;n Industrial dispara econom&amp;iacute;a, sociedad y tecnolog&amp;iacute;a. Babbage concibe la m&amp;aacute;quina diferencial y la anal&amp;iacute;tica (1822), Hollerith usa tarjetas perforadas y Zuse construye las Z1-Z4 y el Mark I.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1071" y="406" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="rt2_1" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;GENERACIONES DE LOS ORDENADORES &amp;#183; cada una reduce coste y tama&amp;ntilde;o y aumenta velocidad y capacidad&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EF6C00;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="285" y="584" width="1825" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_0" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 1.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1944-1953&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Ordenadores con v&amp;aacute;lvulas de vac&amp;iacute;o. ENIAC (1946), primer servicio de telefon&amp;iacute;a m&amp;oacute;vil de Bell Labs (1947) y entrada de datos con tarjetas perforadas (1953).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="285" y="606" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_1" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 2.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1955-1963&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;El transistor permite equipos m&amp;aacute;s peque&amp;ntilde;os y r&amp;aacute;pidos. Dartmouth acu&amp;ntilde;a la inteligencia artificial (1957), se lanza el Sputnik I y llegan los primeros robots industriales.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="547" y="606" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_2" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 3.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1964-1970&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Circuitos integrados con miles de componentes. Corning patenta la fibra &amp;oacute;ptica (1966), ARPANET conecta cuatro ordenadores (1969) e Intel crea la primera memoria RAM (1970).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="809" y="606" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_3" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 4.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1971-1983&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Era del microprocesador y del primer correo electr&amp;oacute;nico. Protocolo TCP/IP (1972), redes LAN Ethernet (1974), CD (1981) y separaci&amp;oacute;n de ARPANET de la red militar: nace Internet (1983).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1071" y="606" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_4" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 5.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1984-1998&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Microelectr&amp;oacute;nica y nanotecnolog&amp;iacute;a abaratan el ordenador personal. Microsoft Windows (1985), World Wide Web (1990), telefon&amp;iacute;a m&amp;oacute;vil GSM (1992) y Google (1998).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1333" y="606" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_5" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 6.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1999-actualidad&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Arquitecturas paralelas con varios procesadores y auge de los dispositivos m&amp;oacute;viles. Wikipedia (2001), impresoras 3D (2009), robot astronauta (2011); hoy IA, nanotecnolog&amp;iacute;a y telecomunicaciones.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1595" y="606" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="band3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#00897B;strokeWidth=1;dashed=1;dashPattern=6 6;align=left;verticalAlign=top;fontSize=10;fontColor=#00897B;" vertex="1" parent="1">
          <mxGeometry x="40" y="812" width="2090" height="400" as="geometry" />
        </mxCell>
        <mxCell id="cap3" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;3. UN MUNDO DIGITAL CONECTADO A LA RED&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Internet nace en los a&amp;ntilde;os sesenta y hoy permite conectarse desde cualquier lugar y en cualquier momento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#00897B;strokeColor=#00897B;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="828" width="200" height="368" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78909C;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cap2" target="cap3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3_0_0" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;3.1 Nativos digitales&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Conviven dos generaciones con la misma tecnolog&amp;iacute;a: los nativos, criados entre pantallas y redes, con gran destreza; y los inmigrantes digitales, de la era anal&amp;oacute;gica, que se adaptan con dificultad.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="828" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c3_0_1" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 3.2 El Internet de las cosas&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Objetos cotidianos conectados a Internet que recogen, procesan y comparten informaci&amp;oacute;n sin intervenci&amp;oacute;n del usuario, mediante comunicaci&amp;oacute;n M2M. Se estimaban 50 000 millones de objetos en 2020: seis por habitante.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="547" y="828" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c3_0_2" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; Ejemplos de IoT&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Juguetes con sensores que interact&amp;uacute;an con comunidades virtuales; camisetas conectadas a la nube que cambian de mensaje; y calzado con GPS que controla la rutina de ejercicio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="809" y="828" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c3_0_3" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 3.3 Ciudades inteligentes&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Ciudades que usan la tecnolog&amp;iacute;a para mejorar la calidad de vida, los recursos y la gesti&amp;oacute;n energ&amp;eacute;tica. Trabajan con innovaci&amp;oacute;n, sostenibilidad, gobierno digital y servicios comunes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1071" y="828" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="rt3_1" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;CIUDADES INTELIGENTES &amp;#183; servicios que prestan&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="285" y="1006" width="1825" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c3_1_0" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; eAdministraci&amp;oacute;n&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Tr&amp;aacute;mites con la Administraci&amp;oacute;n por Internet sin esperas, con acceso inmediato a la informaci&amp;oacute;n y factura electr&amp;oacute;nica.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="285" y="1028" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c3_1_1" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; Teletrabajo&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Actividad laboral a distancia con las TIC: el trabajador desempe&amp;ntilde;a sus funciones desde cualquier lugar con un ordenador conectado.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="547" y="1028" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c3_1_2" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; Tr&amp;aacute;fico y coches aut&amp;oacute;nomos&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Sensores repartidos por la ciudad mejoran aparcamiento y movilidad; los navegadores informan en directo y ya hay veh&amp;iacute;culos que aparcan o conducen solos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="809" y="1028" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c3_1_3" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; eSalud&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;TIC aplicadas al cuidado del paciente y a la gesti&amp;oacute;n sanitaria: sensores que miden az&amp;uacute;car, tensi&amp;oacute;n o ritmo card&amp;iacute;aco en tiempo real.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1071" y="1028" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c3_1_4" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; Casas dom&amp;oacute;ticas&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;La dom&amp;oacute;tica automatiza la vivienda: energ&amp;iacute;a, seguridad, bienestar y comunicaci&amp;oacute;n. Se gestiona tambi&amp;eacute;n a distancia por redes de comunicaciones.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=9;fontColor=#37474F;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1333" y="1028" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="band4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#1E88E5;strokeWidth=1;dashed=1;dashPattern=6 6;align=left;verticalAlign=top;fontSize=10;fontColor=#1E88E5;" vertex="1" parent="1">
          <mxGeometry x="40" y="1234" width="2090" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cap4" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;4. IDENTIDAD DIGITAL&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tambi&amp;eacute;n en la Red hay que acreditar qui&amp;eacute;n es cada uno: DNIe, certificados, contrase&amp;ntilde;as y biometr&amp;iacute;a.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#1E88E5;strokeColor=#1E88E5;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1250" width="200" height="168" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78909C;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cap3" target="cap4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4_0_0" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;4.1 DNIe&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;DNI electr&amp;oacute;nico con chip que acredita la identidad de forma inequ&amp;iacute;voca y firma documentos con validez jur&amp;iacute;dica equivalente a la firma manuscrita. Necesita lector de tarjetas y PIN.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="1250" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c4_0_1" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 4.2 El certificado digital&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Autentica y garantiza la confidencialidad de las comunicaciones en redes abiertas, evitando suplantaciones: solo accede el ciudadano titular. En Espa&amp;ntilde;a lo emiten autoridades como la FNMT.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="547" y="1250" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c4_0_2" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; C&amp;oacute;mo obtenerlo&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Hay que acudir a una oficina de registro, que facilita el software; el usuario lo instala en su ordenador y obtiene una clave privada que lo identifica.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="809" y="1250" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c4_0_3" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 4.3 Contrase&amp;ntilde;as&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;M&amp;eacute;todo m&amp;aacute;s extendido para identificarse y acceder a la informaci&amp;oacute;n personal. Debe ser larga, sin datos personales, alfanum&amp;eacute;rica (may&amp;uacute;sculas, min&amp;uacute;sculas, n&amp;uacute;meros y s&amp;iacute;mbolos) y cambiarse con regularidad.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1071" y="1250" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c4_0_4" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; Truco para crearlas&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Partir de una frase f&amp;aacute;cil de memorizar y acortarla con una regla sencilla: &amp;laquo;Mi perro Canela es un Setter Irland&amp;eacute;s&amp;raquo; se convierte en MpCe1setterIr.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1333" y="1250" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="band5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#8E24AA;strokeWidth=1;dashed=1;dashPattern=6 6;align=left;verticalAlign=top;fontSize=10;fontColor=#8E24AA;" vertex="1" parent="1">
          <mxGeometry x="40" y="1456" width="2090" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cap5" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;5. CONOCIMIENTO COLECTIVO&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Los usuarios dejan de ser receptores pasivos y pasan a crear conocimiento en com&amp;uacute;n.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#8E24AA;strokeColor=#8E24AA;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1472" width="200" height="168" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78909C;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cap4" target="cap5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c5_0_0" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;5.1 Inteligencia colectiva&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Resultado de la colaboraci&amp;oacute;n entre muchos individuos: resuelve problemas multidisciplinares e interpreta ideas desde distintos puntos de vista. La Web 2.0 convierte al consumidor en creador.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="1472" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c5_0_1" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;5.2 Contenidos abiertos&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Trabajos creativos publicados con licencia no restrictiva que permite copiarlos, distribuirlos y modificarlos: REA, MOOC y Open Course, bajo Creative Commons o Copyleft.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="547" y="1472" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c5_0_2" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;5.3 Dimensi&amp;oacute;n social del conocimiento&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;La Red es din&amp;aacute;mica, participativa y colaborativa: blogs, wikis y redes sociales permiten opinar, compartir y relacionarse. Los usuarios son protagonistas activos que crean contenido.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="809" y="1472" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c5_0_3" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ejemplos de creaci&amp;oacute;n colectiva&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;YouTube, una de las mayores comunidades de v&amp;iacute;deo; Wikipedia, enciclopedia editada por usuarios de todo el mundo; y Google Maps y Earth, que permiten geolocalizar y ampliar contenidos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1071" y="1472" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c5_0_4" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Internet como fuente de conocimiento&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Millones de sitios web accesibles a trav&amp;eacute;s de buscadores. La Red re&amp;uacute;ne enciclopedias, diccionarios, bibliotecas virtuales, redes sociales y portales que organizan el conocimiento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1333" y="1472" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="band6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#00ACC1;strokeWidth=1;dashed=1;dashPattern=6 6;align=left;verticalAlign=top;fontSize=10;fontColor=#00ACC1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1678" width="2090" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cap6" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;6. MOVILIDAD, UBICUIDAD Y DISPONIBILIDAD&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Los dispositivos m&amp;oacute;viles permiten interactuar y comunicarse en cualquier lugar y momento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#00ACC1;strokeColor=#00ACC1;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1694" width="200" height="168" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78909C;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cap5" target="cap6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_0" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;6.1 El tel&amp;eacute;fono inteligente&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Smartphone: m&amp;oacute;vil con prestaciones de ordenador personal. Pantalla t&amp;aacute;ctil, agenda, GPS, Wi-Fi, Bluetooth, c&amp;aacute;mara y multitarea. Es la llave del acceso c&amp;oacute;modo a la informaci&amp;oacute;n.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F7FA;strokeColor=#00ACC1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="1694" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_1" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;6.2 Tecnolog&amp;iacute;as ubicuas&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Ubicuo significa &amp;laquo;en todas partes&amp;raquo;: servicios, procesos e informaci&amp;oacute;n disponibles siempre. Los ordenadores se integran en las tareas y dejan de percibirse como m&amp;aacute;quinas.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F7FA;strokeColor=#00ACC1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="547" y="1694" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_2" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;6.3 Navegar con dispositivos m&amp;oacute;viles&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Se navega con Safari, Chrome, Firefox u Opera. Las webs ofrecen versi&amp;oacute;n m&amp;oacute;vil que se activa sola y la interacci&amp;oacute;n es t&amp;aacute;ctil: deslizar, tocar y girar la pantalla.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F7FA;strokeColor=#00ACC1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="809" y="1694" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_3" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;6.4 Correo electr&amp;oacute;nico&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Se lee desde el m&amp;oacute;vil en cualquier lugar y en tiempo real: los datos se sincronizan solos y avisan al llegar un mensaje. Se usa v&amp;iacute;a web o con apps como Outlook o Gmail.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F7FA;strokeColor=#00ACC1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1071" y="1694" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_4" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 6.5 Geolocalizaci&amp;oacute;n&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Localiza autom&amp;aacute;ticamente un objeto en un sistema de coordenadas usando un dispositivo con GPS y cartograf&amp;iacute;a. Sirve para planificar recorridos y compartir la posici&amp;oacute;n en tiempo real por redes sociales.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F7FA;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1333" y="1694" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_5" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 6.6 Realidad aumentada&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;A&amp;ntilde;ade informaci&amp;oacute;n virtual a la realidad: el receptor GPS y la br&amp;uacute;jula ubican al usuario y la c&amp;aacute;mara superpone datos sobre el entorno (paradas, restaurantes, monumentos). Ejemplo: Layar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F7FA;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1595" y="1694" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c6_0_6" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;6.7 Apps&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Aplicaciones de los tel&amp;eacute;fonos inteligentes para b&amp;uacute;squedas, juegos, mapas, videoconferencias, v&amp;iacute;deo, m&amp;uacute;sica o fotos: hacen m&amp;aacute;s c&amp;oacute;moda la sociedad digital.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F7FA;strokeColor=#00ACC1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1857" y="1694" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="band7" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#43A047;strokeWidth=1;dashed=1;dashPattern=6 6;align=left;verticalAlign=top;fontSize=10;fontColor=#43A047;" vertex="1" parent="1">
          <mxGeometry x="40" y="1900" width="2090" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cap7" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;7. NUEVOS DESARROLLOS DE LAS TIC&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Avances que hoy impulsan la evoluci&amp;oacute;n de la inform&amp;aacute;tica y las comunicaciones.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#43A047;strokeColor=#43A047;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1916" width="200" height="168" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78909C;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cap6" target="cap7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c7_0_0" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 7.1 Rob&amp;oacute;tica&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;M&amp;aacute;quinas programables que ejecutan tareas complejas combinando mec&amp;aacute;nica, electr&amp;oacute;nica e inform&amp;aacute;tica. Nuevos materiales permiten robots imposibles: industriales, androides, espaciales o zoomorfos (Geminoid, ASIMO, Robonaut).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="1916" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c7_0_1" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 7.2 Inteligencia artificial&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Rama que imita los procesos de la inteligencia humana: automatiza tareas con comportamiento inteligente, planifica, diagnostica y reconoce escritura, habla y patrones. Se aplica en econom&amp;iacute;a, medicina o ingenier&amp;iacute;a.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="547" y="1916" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c7_0_2" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;7.3 Sistemas distribuidos&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Ordenadores conectados en red que trabajan con un fin com&amp;uacute;n: comparten hardware y software y aprovechan mejor el trabajo. Forman un superordenador virtual mediante comunicaci&amp;oacute;n m&amp;aacute;quina a m&amp;aacute;quina.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="809" y="1916" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c7_0_3" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;7.4 Litograf&amp;iacute;a&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;T&amp;eacute;cnica de impresi&amp;oacute;n que la inform&amp;aacute;tica adapta como fotolitograf&amp;iacute;a para fabricar chips cada vez m&amp;aacute;s peque&amp;ntilde;os. El haz de electrones (e-beam) supera sus limitaciones de tama&amp;ntilde;o.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1071" y="1916" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c7_0_4" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 7.5 Nanotecnolog&amp;iacute;a&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Estudia sistemas a escala de &amp;aacute;tomos y mol&amp;eacute;culas: un nan&amp;oacute;metro es la millon&amp;eacute;sima parte de un mil&amp;iacute;metro. Sus tres grandes sectores son nanoelectr&amp;oacute;nica, nanobiotecnolog&amp;iacute;a y nanomateriales.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1333" y="1916" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c7_0_5" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 7.6 Inform&amp;aacute;tica cu&amp;aacute;ntica&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Aprovecha las propiedades de las part&amp;iacute;culas en lugar de los voltajes el&amp;eacute;ctricos. El qubit o bit cu&amp;aacute;ntico admite varios valores a la vez, con potencia de c&amp;aacute;lculo casi ilimitada; ya hay chips cu&amp;aacute;nticos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1595" y="1916" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c7_0_6" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;#9733; 7.7 Bioinform&amp;aacute;tica&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;br style=&quot;font-size:4px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#455A64&quot;&gt;Confluyen biolog&amp;iacute;a, inform&amp;aacute;tica y tecnolog&amp;iacute;as de la informaci&amp;oacute;n. Biochips y transistores org&amp;aacute;nicos transfieren se&amp;ntilde;al el&amp;eacute;ctrica a mol&amp;eacute;culas org&amp;aacute;nicas e imitan a las neuronas; tambi&amp;eacute;n los diodos OLED.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#C62828;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;fontColor=#37474F;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1857" y="1916" width="240" height="162" as="geometry" />
        </mxCell>
        <mxCell id="fuente" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Fuente:&lt;/b&gt; Tema 1 &amp;laquo;La sociedad del conocimiento. Nuevas tecnolog&amp;iacute;as&amp;raquo; (Aula Virtual). Esquema propio: cada tarjeta condensa en tres l&amp;iacute;neas el p&amp;aacute;rrafo correspondiente del libro; no es un resumen ni un &amp;iacute;ndice.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FAFAFA;strokeColor=#CFD8DC;align=center;verticalAlign=middle;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="40" y="2122" width="2090" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
