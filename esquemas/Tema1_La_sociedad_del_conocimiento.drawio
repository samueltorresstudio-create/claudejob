        <mxCell id="c7_0_0" value="&lt;font style=&quot;font-size:11px;color:#2E7D32&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;7.1 Rob&amp;oacute;tica&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;M&amp;aacute;quinas programables que unen mec&amp;aacute;nica, electr&amp;oacute;nica e inform&amp;aacute;tica: industriales, androides y zoomorfos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="318" y="1942" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c7_0_1" value="&lt;font style=&quot;font-size:11px;color:#2E7D32&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;&amp;#9733; &lt;/font&gt;7.2 Inteligencia artificial&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Imita procesos humanos: automatiza tareas, planifica, diagnostica y reconoce habla, escritura y patrones.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="606" y="1942" width="272" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c7_0_2" value="&lt;font style=&quot;font-size:11px;color:#2E7D32&quot;&gt;&lt;b&gt;7.3 Sistemas distribuidos&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Ordenadores en red con un fin com&amp;uacute;n: comparten recursos y forman un superordenador virtual.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
