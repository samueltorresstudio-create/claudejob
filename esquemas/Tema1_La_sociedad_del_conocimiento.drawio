        <mxCell id="c6_1_2" value="&lt;font style=&quot;font-size:11px;color:#00838F&quot;&gt;&lt;b&gt;6.7 Apps&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;br style=&quot;font-size:5px&quot;&gt;&lt;font style=&quot;font-size:10px;color:#4A5B66&quot;&gt;Aplicaciones para buscar, jugar, ver mapas, v&amp;iacute;deo o fotos: hacen c&amp;oacute;moda la sociedad digital.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;shadow=1;" vertex="1" parent="1">
