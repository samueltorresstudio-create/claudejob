        <mxCell id="cap6" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;6. MOVILIDAD, UBICUIDAD Y DISPONIBILIDAD&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;br style=&quot;font-size:8px&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Interactuar y comunicarse en cualquier lugar y en cualquier momento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#00838F;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
