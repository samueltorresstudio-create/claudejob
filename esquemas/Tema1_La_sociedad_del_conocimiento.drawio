        <mxCell id="rt2_1" value="&lt;font style=&quot;font-size:12.5px&quot;&gt;&lt;b&gt;GENERACIONES DE LOS ORDENADORES &amp;#183; cada una reduce coste y tama&amp;ntilde;o y gana velocidad&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#D8511A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="362" y="726" width="1294" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c2_1_0" value="&lt;font style=&quot;font-size:13.5px;color:#D8511A&quot;&gt;&lt;b&gt;&lt;font color=&quot;#B02A25&quot;&gt;&amp;#9733; &lt;/font&gt;1.&amp;ordf; Generaci&amp;oacute;n &amp;#183; 1944-1953&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;br style=&quot;font-size:6px&quot;&gt;&lt;font style=&quot;font-size:11.5px;color:#41525C&quot;&gt;V&amp;aacute;lvulas de vac&amp;iacute;o. ENIAC (1946), primer servicio de telefon&amp;iacute;a m&amp;oacute;vil (1947) y tarjetas perforadas (1953).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B02A25;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=46;spacingTop=6;shadow=1;" vertex="1" parent="1">
